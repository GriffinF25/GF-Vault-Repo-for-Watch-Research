# Copy to .env and fill in from your Supabase project settings (Project Settings > API).
# These are PUBLIC values safe to ship in the app bundle — the anon key only
# grants what RLS policies allow. Never put the service role key or the
# Anthropic API key here; those live only in the Edge Function's environment.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
